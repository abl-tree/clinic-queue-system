VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_public_key

VITE_USE_EMULATORS=false

VITE_APP_NAME=Clinic Queue

VITE_ENCRYPTION_KEY=your_encryption_key_change_in_production

# Facebook Messenger
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
MESSENGER_VERIFY_TOKEN=your_webhook_verify_token

# App URL (for Messenger deep links)
VITE_APP_URL=https://your-vercel-app.vercel.app

# Firebase Service Account (for Vercel serverless functions - Firebase Admin SDK)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cron secret to protect /api/cleanup-queues endpoint
CRON_SECRET=your_random_cron_secret_here